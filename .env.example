# 复制为 .env 后按需修改；敏感项勿提交
# 注意：选 yaml（default→{APP_ENV}.yaml）只读「进程环境」里的 APP_ENV；
# 本文件里的 APP_ENV 不会改已选定的环境文件（须 export APP_ENV=... 或 make 传入）。
APP_ENV=dev

# PostgreSQL 18
# - DB_DSN：仅给 make migrate-up / migrate-down（golang-migrate URL 格式，业务进程不读）
# - 业务进程连库：DB_DSN_SQL（完整 pgx URL）或 DB_USER/DB_PASS/DB_HOST/DB_PORT/DB_NAME
#   export DB_DSN=...   或 PowerShell: $env:DB_DSN='...'
DB_DSN=postgres://scaffold:scaffold123@127.0.0.1:5432/scaffold?sslmode=disable
# DB_DSN_SQL=postgres://scaffold:scaffold123@127.0.0.1:5432/scaffold?sslmode=disable
DB_USER=scaffold
DB_PASS=scaffold123
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=scaffold

# Redis
REDIS_HOST=127.0.0.1:6379
REDIS_PASS=

# Etcd（full compose 时取消注释；直连请保持注释以免误开 Watch）
# 若在 K8s 启用：须同步放行 api→etcd:2379 出站（见 deploy/deployment.yaml 注释）
# ETCD_HOSTS=127.0.0.1:2379
