# 复制为 .env 后按需修改；敏感项勿提交
# 注意：选 yaml（default→{APP_ENV}.yaml）只读「进程环境」里的 APP_ENV；
# 本文件里的 APP_ENV 不会改已选定的环境文件（须 export APP_ENV=... 或 make 传入）。
# 合并顺序：default.yaml → {APP_ENV}.yaml → config-local.yaml → 本文件 / 环境变量。
APP_ENV=dev

# ── PostgreSQL 18 ──────────────────────────────────────────────────────────
# - DB_DSN：仅给 make migrate-up / migrate-down（golang-migrate URL 格式，业务进程不读）
# - 业务进程连库：DB_DSN_SQL（完整 pgx URL）或 DB_USER/DB_PASS/DB_HOST/DB_PORT/DB_NAME
#   export DB_DSN=...   或 PowerShell: $env:DB_DSN='...'
# - DB_SSLMODE 覆盖 DSN 的 sslmode；未设时 prod→verify-full，其余→disable
#   （prod 禁止 disable/allow/prefer；云 RDS 无可用 CA 时可显式 require）
DB_DSN=postgres://scaffold:scaffold123@127.0.0.1:5432/scaffold?sslmode=disable
# DB_DSN_SQL=postgres://scaffold:scaffold123@127.0.0.1:5432/scaffold?sslmode=disable
DB_USER=scaffold
DB_PASS=scaffold123
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=scaffold
# DB_SSLMODE=require

# ── Redis ─────────────────────────────────────────────────────────────────
# 配 REDIS_HOST 后启动即真实 PING，失败一律 fail-fast（含非 prod）。
REDIS_HOST=127.0.0.1:6379
REDIS_PASS=
# 阿里云 5.0+ 自定义账号：配 REDIS_USER 后组装为 AUTH user:pass；TLS 实例置 REDIS_TLS=true
# REDIS_USER=scaffold_user
# REDIS_TYPE=node
# REDIS_TLS=true

# ── 阿里云 OSS ─────────────────────────────────────────────────────────────
# 四项齐备才探活（health oss=ok/degraded）；缺任一项视为未启用（health oss=skipped，不报错）。
# ENDPOINT 只写域名、不带 bucket 前缀；prod 用 http:// 会被拒（除非 OSS_ALLOW_INSECURE=true）。
# OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
# OSS_BUCKET=scaffold-dev
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=

# ── 阿里云 RocketMQ 5.x ────────────────────────────────────────────────────
# 填 MQ_ENDPOINT 即建连探活；InstanceID 留空则从 Endpoint 推导。
# VPC 内网实例可免密（AK/SK 留空）；公网访问须配齐 AK/SK。
# MQ_ENDPOINT=rmq-cn-xxxxx-vpc.cn-shenzhen.rmq.aliyuncs.com:8080
# MQ_INSTANCE=
# MQ_TOPIC=scaffold
# MQ_GROUP=GID_scaffold
# MQ_ACCESS_KEY=
# MQ_ACCESS_KEY_SECRET=

# ── 阿里云 SLS（日志服务）───────────────────────────────────────────────────
# 五项齐备（ENDPOINT/PROJECT/LOGSTORE/AK/SK）才启用：探活 + 挂 logx 额外 Writer 双写
# （Log.Mode=file 保持不变）；缺任一项视为未启用（health sls=skipped）。
# SLS_ENDPOINT=cn-shenzhen.log.aliyuncs.com
# SLS_PROJECT=
# SLS_LOGSTORE=
# SLS_ACCESS_KEY_ID=
# SLS_ACCESS_KEY_SECRET=
# SLS_TOPIC=
# SLS_SOURCE=
#
# 探活失败语义：OSS/Redis 一律 fail-fast；MQ/SLS 仅 prod fail-fast，
# 非 prod 只告警并让 health 显示 degraded，便于本地无网时照常开发。

# ── 阿里云 VPC 约定 ─────────────────────────────────────────────────────────
# 覆盖 config/*.yaml 的 Cloud 段。PreferInternalEndpoint=true 时把「同地域」的
# OSS/SLS 公网域名改写成 -internal（跨地域不改写，跨区内网不可达）；
# deploy 的 NetworkPolicy ipBlock 须与 CLOUD_VPC_CIDR 对齐。
# CLOUD_REGION=cn-shenzhen
# CLOUD_VPC_CIDR=172.16.0.0/16
# CLOUD_PREFER_INTERNAL=true

# ── Etcd（full compose 时取消注释；直连请保持注释以免误开 Watch）──────────────
# 启用 Etcd 即须 ETCD_HOTRELOAD_TOKEN；prod 另须 TLS 三件套齐全，
# 或 ETCD_ALLOW_INSECURE=true 走 break-glass（会打 SECURITY 日志）。
# TLS 三件套须同时给，缺一即报「etcd TLS incomplete」。
# 若在 K8s 启用：须同步放行 api→etcd:2379 出站（见 deploy/deployment.yaml 注释）
# ETCD_HOSTS=127.0.0.1:2379
# ETCD_HOTRELOAD_TOKEN=
# ETCD_CERT_FILE=
# ETCD_KEY_FILE=
# ETCD_CA_FILE=
# ETCD_ALLOW_INSECURE=

# ── 生产安全开关（仅环境变量生效，yaml 无对应字段）──────────────────────────
# AUTH_MODE 覆盖 Auth.Mode（dev|require|sdk）；test/prod 禁 dev，sdk 尚未接入。
# prod 走 require 门闩须同时给两个开关：AUTH_ALLOW_PHASE1_GATE=true
#   且 AUTH_PHASE1_ACK=I_UNDERSTAND_NOT_FOR_PUBLIC（值见 pkg/auth.Phase1AckValue）。
# HEALTH_PROBE_TOKEN：prod 必填；HEALTH_PROBE_REQUIRE_TOKEN=true 时本机回环也须带
#   X-Health-Probe-Token 头。HEALTH_EXPOSE_DEPENDENCIES 覆盖 /health 是否暴露依赖明细。
# *_ALLOW_INSECURE：仅 break-glass，放行 prod 下 http/明文连接（OSS/REDIS/SLS）。
# AUTH_MODE=dev
# AUTH_ALLOW_PHASE1_GATE=
# AUTH_PHASE1_ACK=
# HEALTH_PROBE_TOKEN=
# HEALTH_PROBE_REQUIRE_TOKEN=
# HEALTH_EXPOSE_DEPENDENCIES=
# OSS_ALLOW_INSECURE=
# REDIS_ALLOW_INSECURE=
# SLS_ALLOW_INSECURE=
