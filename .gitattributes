# 统一 LF 行尾。
# 理由：CRLF 的 Makefile 在 WSL / Linux / CI 上会报 "missing separator"；
# 本仓含大量 .tpl / .in / Dockerfile / Makefile，混合行尾会放大该问题。
* text=auto eol=lf

# 二进制文件不做行尾转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.tar   binary
*.exe   binary
*.so    binary
*.dll   binary
*.woff  binary
*.woff2 binary
